# Canonical public URL (no trailing slash). Used for Open Graph, Twitter cards, and absolute links.
# Required for correct previews when sharing on WhatsApp, Slack, Facebook, etc.
# Examples: https://www.yourdomain.com  or  https://your-site.netlify.app
NEXT_PUBLIC_SITE_URL=

